# Which AI provider reviews the contract: "anthropic" (Claude), "gemini" (default) or "groq".
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: Claude model to use (default claude-sonnet-5).
CLAUDE_MODEL=claude-sonnet-5
# Needed only if the Anthropic key is not tied to a workspace (copy the ID from the console).
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: only needed if LLM_PROVIDER=groq. Groq is faster but cannot read scanned PDFs or PNGs.
GROQ_API_KEY=your_groq_api_key_here
PORT=4000
